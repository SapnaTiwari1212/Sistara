# ---------------------------------------------------------------------------
# SISTARA backend — environment template
# ---------------------------------------------------------------------------
# Copy this file to `backend/.env` and fill in the values you need.
# backend/.env is never committed (see root .gitignore).
#
# With no .env file the server still boots in development using the local
# MongoDB fallback and an ephemeral JWT secret (sessions reset on restart).
# In production the server refuses to start without JWT_SECRET.
# ---------------------------------------------------------------------------

# Port the API listens on
PORT=5000

# development | test | production
NODE_ENV=development

# MongoDB connection string (defaults to a locally running MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/sistara

# Long random string used to sign JWTs — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Allowed browser origins for CORS (comma-separated if more than one).
# The deployed Vercel frontend goes here, e.g. https://sistara.vercel.app
FRONTEND_URL=http://localhost:5173